<?php

/**
 * @file
 * Varbase Vartheme Claro.
 *
 * Have custom alteration over the theme layer.
 *
 * Hook logic lives in \Drupal\vartheme_claro\Hook\VarthemeClaroHooks
 * (Drupal 11 OOP hooks); the procedural functions below are kept as
 * #[LegacyHook] shims for backward compatibility.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\vartheme_claro\Hook\VarthemeClaroHooks;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
#[LegacyHook]
function vartheme_claro_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  \Drupal::classResolver(VarthemeClaroHooks::class)->themeSuggestionsPageAlter($suggestions, $variables);
}

/**
 * Implements hook_library_info_alter().
 */
#[LegacyHook]
function vartheme_claro_library_info_alter(&$libraries, $extension) {
  \Drupal::classResolver(VarthemeClaroHooks::class)->libraryInfoAlter($libraries, $extension);
}
